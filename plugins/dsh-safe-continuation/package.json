{
  "name": "dsh-safe-continuation",
  "version": "0.1.0",
  "description": "Scaffolded bundle for safe continuation runtime contracts in DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./runtime-types": "./lib/runtime-types.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types tests/**/*.test.ts",
    "typecheck": "tsc --pretty false --project tsconfig.json",
    "bundle": "tsdown && node ./scripts/normalize-lib.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
